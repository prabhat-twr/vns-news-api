# Export these into your shell, or pass --env-file to Docker. Python does not auto-read .env.
KASHI_PROVIDER=ollama
KASHI_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
# Install .[dense] before enabling local dense embeddings.
KASHI_EMBEDDINGS=huggingface
KASHI_RERANK=false
KASHI_NEWS_URL=https://raw.githubusercontent.com/prabhat-twr/vns-news-api/main/news.json
KASHI_REFRESH_SECONDS=900
KASHI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend build-time configuration (frontend/.env.local or Netlify environment):
# VITE_API_URL=https://YOUR-BACKEND.example
